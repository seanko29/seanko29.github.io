# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# 선택 설정
# claude-opus-5(가장 정확) / claude-sonnet-5(권장) / claude-haiku-4-5(가장 저렴)
REVIEW_MODEL=claude-opus-5

# 생각 깊이: low / medium / high — 낮출수록 싸고 빠릅니다 (Haiku는 미지원)
REVIEW_EFFORT=medium
# 업로드 사진의 긴 변을 이 픽셀로 줄여서 전송합니다(토큰 비용 절감).
# 원본 화질이 필요하면 2576까지 올릴 수 있습니다.
REVIEW_MAX_IMAGE_PX=1568
